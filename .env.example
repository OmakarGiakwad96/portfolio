# Copy to .env.local and fill in to let /api/contact deliver email via SMTP.
# If these are left empty, the contact form falls back to opening the
# visitor's email app (mailto:) — the site still works.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Where messages are delivered (defaults to SMTP_USER)
CONTACT_TO=
